rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User workspace
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update, delete: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      match /accounts/{accountId} {
        allow list: if isOwner(userId);
        allow get, create, update, delete: if isOwner(userId) && isValidId(accountId);
      }

      match /categories/{categoryId} {
        allow list: if isOwner(userId);
        allow get, create, update, delete: if isOwner(userId) && isValidId(categoryId);
      }

      match /transactions/{transactionId} {
        allow list: if isOwner(userId);
        allow get, create, update, delete: if isOwner(userId) && isValidId(transactionId);
      }

      match /rules/{ruleId} {
        allow list: if isOwner(userId);
        allow get, create, update, delete: if isOwner(userId) && isValidId(ruleId);
      }

      match /dreams/{dreamId} {
        allow list: if isOwner(userId);
        allow get, create, update, delete: if isOwner(userId) && isValidId(dreamId);
      }

      match /budgets/{budgetId} {
        allow list: if isOwner(userId);
        allow get, create, update, delete: if isOwner(userId) && isValidId(budgetId);
      }
    }
  }
}
